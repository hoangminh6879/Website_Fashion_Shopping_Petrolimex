PORT=5000
MONGO_URI=mongodb://localhost:27017/petrolimex_fashion
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES=7d

# Google OAuth Credentials
# Lấy tại: https://console.cloud.google.com/
# THAY CÁI GOOGLE_CLIENT_ID và GOOGLE_CLIENT_SECRE
# GOOGLE_CLIENT_CALLBACK_URL giữ nguyên
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CLIENT_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URL
FRONTEND_URL=http://localhost:5173


# Lấy tại: https://myaccount.google.com/apppasswords
# Login
# Cái EMAIL_USER LÀ CÁI EMAIL CỦA MÌNH
# Sau đó nó trả về cái mã mật khẩu thì lấy cái mã đó trả về cái EMAIL_PASS
# Email Credentials (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
